# SALIN menjadi .env pada server. Jangan commit file .env.
# Nomor internasional tanpa tanda +, pisahkan beberapa owner dengan koma.
OWNER_NUMBERS=6281234567890
ADMIN_NUMBER=6281234567890

# Opsional: override profil toko dari config/business.local.js
BOT_TIMEZONE=Asia/Jakarta
BOT_OPEN=08:00
BOT_CLOSE=17:00

# Folder sesi WhatsApp. Pastikan berada di disk VPS persisten.
AUTH_FOLDER=auth_info_baileys
LOG_LEVEL=info
